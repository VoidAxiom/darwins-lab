{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npx tsc:*)",
      "Bash(npx vitest run:*)",
      "Bash(npx vite build:*)",
      "Bash(npm run inspect:*)",
      "Bash(npm run sim:headless:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(git pull --ff-only:*)",
      "Bash(git push:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(scripts/review-gate.sh:*)",
      "Bash(bash scripts/review-gate.sh:*)",
      "Bash(scripts/codex-run.sh:*)",
      "Bash(bash scripts/codex-run.sh:*)",
      "Bash(codex exec:*)",
      "Bash(codex exec resume:*)",
      "mcp__linear__*",
      "mcp__chrome-devtools__*"
    ],
    "deny": [
      "Bash(codex exec:* --dangerously-bypass-approvals-and-sandbox)",
      "Bash(codex exec:* danger-full-access)",
      "Bash(codex exec:* network_access=true)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push:* --force)",
      "Bash(git push:* --force-with-lease)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(gh pr merge:* --admin)",
      "Bash(npm run narrator:*)",
      "Bash(tsx scripts/narrator-server.ts:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-context.sh",
            "timeout": 15,
            "statusMessage": "Loading Darwin's Lab continuation digest"
          }
        ]
      }
    ]
  }
}
